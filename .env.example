# Backend the webpack dev server proxies /papi and /files to.
#
# These are loaded by bun via `bun --env-file=.env.<ENV>` — see the Makefile
# `serve` target (`make serve ENV=development|production|aries`).
#
# Committed per-environment files: .env.development, .env.production, .env.aries
# Personal overrides go in .env.local (gitignored).
#
# Note: the tokens used here are non-sensitive dev/test tokens, not real
# production credentials.

MIRA_API_TARGET=http://localhost
MIRA_API_TOKEN=your-token-here
